<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="SAEScriptableTestApp Terminology">
	<suite name="Standard Suite" code="core" description="Common classes and commands used to exercise SinterAppleEvents.">
		<command name="quit" code="aevtquit" description="Quit the application.">
			<cocoa class="NSQuitCommand"/>
		</command>
		<command name="count" code="corecnte" description="Return the number of elements of a particular class within an object.">
			<parameter name="each" code="kocl" type="type" optional="yes" description="The class of objects to be counted."/>
			<result type="integer" description="The count."/>
		</command>
		<command name="delete" code="coredelo" description="Delete an object.">
			<direct-parameter type="specifier" description="The object to delete."/>
		</command>
		<command name="get" code="coregetd" description="Get the data for an object.">
			<direct-parameter type="specifier" description="The object whose data is to be returned."/>
			<result type="any" description="The data from the object."/>
		</command>
		<command name="make" code="corecrel" description="Make a new object.">
			<parameter name="new" code="kocl" type="type" description="The class of the new object."/>
			<parameter name="with properties" code="prdt" type="record" optional="yes" description="The initial values for properties of the new object."/>
			<result type="specifier" description="The new object."/>
		</command>
		<command name="set" code="coresetd" description="Set an object's data.">
			<direct-parameter type="specifier" description="The object to change."/>
			<parameter name="to" code="data" type="any" description="The new value."/>
		</command>
		<class name="application" code="capp" description="The application's top-level scripting object.">
			<element type="document" description="The application's open documents.">
				<cocoa key="documents"/>
			</element>
			<property name="name" code="pnam" type="text" access="r" description="The name of the application."/>
		</class>
		<class name="document" code="docu" description="A document that has a name.">
			<property name="name" code="pnam" type="text" description="The document's name."/>
		</class>
	</suite>
</dictionary>
